{
  "name": "proton",
  "private": true,
  "description": "Infrastructure utilities shared by the sibling projects in ~/Projects",
  "type": "module",
  "exports": {
    "./devops": "./devops/index.ts",
    "./hot": "./hot/index.ts",
    "./esbuild": "./bundler/arrmaturaTemplatePluginEsbuild.ts",
    "./vite": "./bundler/arrmaturaTemplatePluginVite.ts"
  },
  "scripts": {
    "gates": "npx --yes npm-run-all --parallel typecheck lint test",
    "lint": "biome check ./devops ./hot ./bundler",
    "lint:fix": "biome check --write ./devops ./hot ./bundler",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "vitest": "^5.0.1",
    "arrmatura": "file://../arrmatura",
    "ultimus": "file://../ultimus"
  }
}
