{
  "name": "arrmatura-support",
  "version": "2.0.0",
  "private": true,
  "description": "Infrastructure utilities shared by the sibling projects in ~/Projects",
  "type": "module",
  "bin": {
    "arrmatura-support": "bin/index.ts"
  },
  "exports": {
    "./meta": "./meta/index.ts"
  },
  "scripts": {
    "check:deps": "bun bin/index.ts check-deps",
    "gates": "npx --yes npm-run-all --parallel check:deps typecheck lint test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "release": "./ops/release.sh",
    "test": "bun test",
    "typecheck": "tsc",
    "postinstall": "npm run link",
    "link": "./ops/link-modules.sh"
  },
  "dependencies": {
    "@types/bun": "^1.4.4"
  },
  "devDependencies": {
    "arrmatura": "github:arrmatura/arrmatura#semver:^7.0.1",
    "ultimus": "github:arrmatura/ultimus#semver:^2.4.0"
  },
  "peerDependencies": {
    "arrmatura-host": "github:arrmatura/arrmatura-host#semver:^1.0.0"
  },
  "peerDependenciesMeta": {
    "arrmatura-host": {
      "optional": true
    }
  }
}
