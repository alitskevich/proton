{
  "name": "proton",
  "version": "1.0.2",
  "private": true,
  "description": "Infrastructure utilities shared by the sibling projects in ~/Projects",
  "type": "module",
  "bin": {
    "proton": "bin/index.ts"
  },
  "exports": {
    "./devops": "./devops/index.ts",
    "./hot": "./hot/index.ts",
    "./utils-node": "./utils-node/index.ts",
    "./utils-files": "./utils-files/index.ts",
    "./esbuild": "./bundler/arrmaturaTemplatePluginEsbuild.ts",
    "./vite": "./bundler/arrmaturaTemplatePluginVite.ts"
  },
  "scripts": {
    "gates": "npx --yes npm-run-all --parallel typecheck lint test",
    "lint": "biome check ./devops ./hot ./utils-node ./utils-files ./bundler",
    "lint:fix": "biome check --write ./devops ./hot ./utils-node ./utils-files ./bundler",
    "release": "./ops/release.sh",
    "test": "bun test devops hot utils-node utils-files bundler",
    "typecheck": "tsc",
    "postinstall": "npm run link",
    "link": "./ops/link-modules.sh"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "esbuild": "^0.28.2",
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "arrmatura": "github:arrmatura/arrmatura#semver:^7.0.1",
    "ultimus": "github:arrmatura/ultimus#semver:^2.3.9"
  }
}
